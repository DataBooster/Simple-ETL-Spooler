CREATE OR REPLACE TRIGGER EDS.TRG_DAILY_RFSH_TO_SF_TASK_CONF
BEFORE INSERT OR UPDATE ON EDS.DAILY_RFSH_TO_SF_TASK_CONF
FOR EACH ROW
DECLARE
    tRendered_Query VARCHAR2(4000);
BEGIN
    :new.TARGET_TABLE  := UPPER(TRIM(:new.TARGET_TABLE));
    :new.SOURCE_QUERY  := RTRIM(TRIM(:new.SOURCE_QUERY), ';');
    :new.DATE_COLUMN   := UPPER(TRIM(:new.DATE_COLUMN));
    :new.SUBJECT_AREA  := NVL(UPPER(TRIM(:new.SUBJECT_AREA)), 'DEFAULT');
    :new.REFRESH_ORDER := NVL(TRIM(:new.REFRESH_ORDER), '000');
    :new.IS_ENABLED    := NVL(UPPER(TRIM(:new.IS_ENABLED)), 'Y');
    :new.COMMENT_      := TRIM(:new.COMMENT_);

    tRendered_Query := ERS.UTIL_CONF_RENDERER.RENDER_ENV_PLACEHOLDER(:new.SOURCE_QUERY);
END TRG_DAILY_RFSH_TO_SF_TASK_CONF;
/
